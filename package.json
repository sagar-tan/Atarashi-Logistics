{
  "name": "atarashi-logistics",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:customer": "npm run start -w @atarashi/customer",
    "dev:driver": "npm run start -w @atarashi/driver",
    "dev:admin": "npm run dev -w @atarashi/admin",
    "dev:api": "npm run dev -w @atarashi/api",
    "build:admin": "npm run build -w @atarashi/admin",
    "build:api": "npm run build -w @atarashi/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "oxlint apps packages"
  },
  "engines": { "node": ">=22.11.0" }
}
